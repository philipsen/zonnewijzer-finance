# Copy to .env (not committed). Used by the app when implemented.
GNUCASH_POSTGRES_URL=postgresql://gnucash:gnucash@127.0.0.1:5433/gnucash_dev
SYNC_API_KEY=change-me
INCOME_ACCOUNT=Income:Charging
# Invoice lines: tax table by name (must exist in book).
INVOICE_TAX_TABLE_NAME=BTW hoog
# When INVOICE_AUTO_POST=true (default): post to receivable + income + tax; needs INVOICE_POST_ACCOUNT or a RECEIVABLE account.
INVOICE_AUTO_POST=true
INVOICE_POST_ACCOUNT=
# false: unitPrice/lineAmount are ex-VAT (matches app mapper). true: line totals are VAT-inclusive.
INVOICE_TAX_INCLUDED=false
SEQ_SERVER_URL=http://localhost:5341
SEQ_API_KEY=
# Smappee is configured for the Finance backend only (Backend/.env — see Backend/smappee.env.example).
