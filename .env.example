# Finance App Environment Configuration
# Copy this to .env and customize as needed

# Database Configuration
DATABASE_PATH=/app/database/finance.db
LOCAL_DATA_DIR=./data

# Backend Configuration
ASPNETCORE_ENVIRONMENT=Production
BACKEND_PORT=5000

# Frontend Configuration  
FRONTEND_PORT=3000

# Nginx Configuration (production deployment only)
HTTP_PORT=8080

# Google OAuth (Required for authentication)
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Configuration
JWT_SECRET_KEY=your-very-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# Database Backup
BACKUP_RETENTION_DAYS=30
# Copy this file to .env and update the values for your deployment

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_KEY=your-super-secret-jwt-key-that-should-be-at-least-256-bits-long
JWT_ISSUER=FinanceApp
JWT_AUDIENCE=FinanceAppUsers

# Google OAuth Configuration
GOOGLE_CLIENT_ID=367881736099-4g29mnk5ho3a1iuosd5uo4ut284gbpql.apps.googleusercontent.com

# Database path (inside container)
DB_PATH=/app/data/finance.db

# External port mapping
EXTERNAL_PORT=5000