# Copy to Backend/.env (or repo-root .env) for local Development.
# LocalSecretsBootstrap maps these to Smappee__* for the ASP.NET app.
SMAPPEE_BASE_URL=https://app1pub.smappee.net
SMAPPEE_API_VERSION=v3
SMAPPEE_CLIENT_ID=
SMAPPEE_CLIENT_SECRET=
SMAPPEE_USERNAME=
SMAPPEE_PASSWORD=
# Optional override (else use appsettings DevelopmentSeed / appsettings):
# SMAPPEE_SERVICE_LOCATION_ID=307785
#
# Hourly background sync (appsettings Smappee:BackgroundSync); override e.g.:
# Smappee__BackgroundSync__Enabled=false
# Smappee__BackgroundSync__IntervalHours=1
# Smappee__BackgroundSync__LookbackDays=90
#
# --- Production / docker-compose.production.yml ---
# Export the same values on the server, or use ASP.NET-style names in a .env next to compose:
# SMAPPEE_CLIENT_ID=...
# SMAPPEE_CLIENT_SECRET=...
# SMAPPEE_USERNAME=...
# SMAPPEE_PASSWORD=...
# SMAPPEE_SERVICE_LOCATION_ID=307785
# SMAPPEE_BASE_URL can be the host only (https://app1pub.smappee.net); the app appends /dev/v3 for API and /dev/v1 for OAuth.
# If you set a full Smappee:BaseUrl in compose, include .../dev/v3. Override token base only if needed: SMAPPEE_OAUTH_BASE_URL=https://app1pub.smappee.net/dev/v1
